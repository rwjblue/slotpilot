#!/usr/bin/env bash
#MISE description="Verify workspace crate dependency direction"

set -euo pipefail

workspace_dependencies() {
  local package="$1"

  cargo tree \
    --package "${package}" \
    --edges normal,build,dev \
    --depth 1 \
    --prefix none |
    sed '1d' |
    awk '$1 ~ /^slotpilot($|-|d$)/ { print $1 }' |
    LC_ALL=C sort -u
}

assert_workspace_dependencies() {
  local package="$1"
  local expected="$2"
  local actual

  actual="$(workspace_dependencies "${package}")"
  if [[ "${actual}" != "${expected}" ]]; then
    echo "unexpected workspace dependencies for ${package}" >&2
    echo "expected:" >&2
    echo "${expected:-<none>}" >&2
    echo "actual:" >&2
    echo "${actual:-<none>}" >&2
    return 1
  fi
}

expected_packages="slotpilot
slotpilot-api
slotpilot-audio
slotpilot-domain
slotpilot-ipc
slotpilot-operations
slotpilot-protocol
slotpilot-storage
slotpilot-testkit
slotpilotd"
actual_packages="$(
  cargo tree \
    --workspace \
    --edges normal,build,dev \
    --depth 0 \
    --prefix none |
    awk '$1 ~ /^slotpilot($|-|d$)/ { print $1 }' |
    LC_ALL=C sort -u
)"
if [[ "${actual_packages}" != "${expected_packages}" ]]; then
  echo "unexpected workspace package set" >&2
  echo "expected:" >&2
  echo "${expected_packages}" >&2
  echo "actual:" >&2
  echo "${actual_packages}" >&2
  exit 1
fi

assert_workspace_dependencies "slotpilot-domain" ""
assert_workspace_dependencies "slotpilot-audio" ""
assert_workspace_dependencies "slotpilot-ipc" "slotpilot-api"
assert_workspace_dependencies "slotpilot-protocol" "slotpilot-domain"
assert_workspace_dependencies "slotpilot-operations" "slotpilot-audio
slotpilot-domain
slotpilot-protocol"
assert_workspace_dependencies "slotpilot-storage" "slotpilot-audio
slotpilot-domain
slotpilot-protocol"
assert_workspace_dependencies "slotpilot-testkit" "slotpilot-audio
slotpilot-domain
slotpilot-operations
slotpilot-protocol"
assert_workspace_dependencies "slotpilot-api" "slotpilot-domain"
assert_workspace_dependencies "slotpilotd" "slotpilot-api
slotpilot-audio
slotpilot-domain
slotpilot-ipc
slotpilot-operations
slotpilot-protocol
slotpilot-storage"
assert_workspace_dependencies "slotpilot" "slotpilot-api
slotpilot-domain
slotpilot-ipc"

expected_protocol_features="alloc
fft-rustfft
ft8
std"
actual_protocol_features="$(
  cargo tree \
    --package slotpilot-protocol \
    --edges features \
    --prefix none |
    awk '$1 == "mfsk-core" && $2 == "feature" {
      gsub(/"/, "", $3)
      print $3
    }' |
    LC_ALL=C sort -u
)"
if [[ "${actual_protocol_features}" != "${expected_protocol_features}" ]]; then
  echo "unexpected mfsk-core feature surface" >&2
  echo "expected:" >&2
  echo "${expected_protocol_features}" >&2
  echo "actual:" >&2
  echo "${actual_protocol_features:-<none>}" >&2
  exit 1
fi

if ! grep -Fq \
  'mfsk-core = { version = "=0.7.4", default-features = false, features = ["ft8", "fft-rustfft"] }' \
  Cargo.toml; then
  echo "mfsk-core must remain exactly pinned with the reviewed feature set" >&2
  exit 1
fi

actual_cpal_features="$(
  cargo tree \
    --package slotpilot-audio \
    --edges features \
    --prefix none |
    awk '$1 == "cpal" && $2 == "feature" {
      gsub(/"/, "", $3)
      print $3
    }' |
    LC_ALL=C sort -u
)"
if [[ -n "${actual_cpal_features}" ]]; then
  echo "unexpected CPAL optional feature surface" >&2
  echo "${actual_cpal_features}" >&2
  exit 1
fi

if ! grep -Fq \
  'cpal = { version = "=0.18.1", default-features = false }' \
  Cargo.toml; then
  echo "CPAL must remain exactly pinned with optional/default features disabled" >&2
  exit 1
fi

actual_rustfft_features="$(
  cargo tree \
    --package slotpilot-audio \
    --edges features \
    --prefix none |
    awk '$1 == "rustfft" && $2 == "feature" {
      gsub(/"/, "", $3)
      print $3
    }' |
    LC_ALL=C sort -u
)"
if [[ -n "${actual_rustfft_features}" ]]; then
  echo "unexpected RustFFT optional feature surface" >&2
  echo "${actual_rustfft_features}" >&2
  exit 1
fi

if ! grep -Fq \
  'rustfft = { version = "=6.4.1", default-features = false }' \
  Cargo.toml; then
  echo "RustFFT must remain exactly pinned with optional/default features disabled" >&2
  exit 1
fi

expected_rustfft_import="crates/audio/src/spectrum.rs"
actual_rustfft_imports="$(
  find crates apps \
    -type f \
    -name '*.rs' \
    -exec grep -l 'rustfft::' {} + |
    LC_ALL=C sort
)"
if [[ "${actual_rustfft_imports}" != "${expected_rustfft_import}" ]]; then
  echo "RustFFT imports escaped the private receive spectrum adapter" >&2
  echo "expected:" >&2
  echo "${expected_rustfft_import}" >&2
  echo "actual:" >&2
  echo "${actual_rustfft_imports:-<none>}" >&2
  exit 1
fi

expected_cpal_imports="$(
  printf '%s\n' \
    "crates/audio/src/capture.rs" \
    "crates/audio/src/discovery.rs"
)"
actual_cpal_imports="$(
  find crates apps \
    -type f \
    -name '*.rs' \
    -exec grep -l 'cpal::' {} + |
    LC_ALL=C sort
)"
if [[ "${actual_cpal_imports}" != "${expected_cpal_imports}" ]]; then
  echo "CPAL imports escaped the private receive adapters" >&2
  echo "expected:" >&2
  echo "${expected_cpal_imports}" >&2
  echo "actual:" >&2
  echo "${actual_cpal_imports:-<none>}" >&2
  exit 1
fi

if grep -En \
  'default_input_device|default_output_device|build_(input|output)_stream' \
  crates/audio/src/discovery.rs; then
  echo "receive discovery gained default-device selection or stream creation" >&2
  exit 1
fi

if grep -En \
  'default_input_device|default_output_device|default_input_config|build_output_stream' \
  crates/audio/src/capture.rs; then
  echo "receive capture gained default-device/configuration selection or output creation" >&2
  exit 1
fi

actual_queue_features="$(
  cargo tree \
    --package slotpilot-audio \
    --edges features \
    --prefix none |
    awk '$1 == "crossbeam-queue" && $2 == "feature" {
      gsub(/"/, "", $3)
      print $3
    }' |
    LC_ALL=C sort -u
)"
expected_queue_features="$(
  printf '%s\n' \
    "alloc" \
    "std"
)"
if [[ "${actual_queue_features}" != "${expected_queue_features}" ]]; then
  echo "unexpected crossbeam-queue feature surface" >&2
  echo "expected:" >&2
  echo "${expected_queue_features}" >&2
  echo "actual:" >&2
  echo "${actual_queue_features:-<none>}" >&2
  exit 1
fi

if ! grep -Fq \
  'crossbeam-queue = { version = "=0.3.13", default-features = false, features = ["std"] }' \
  Cargo.toml; then
  echo "crossbeam-queue must remain exactly pinned with the reviewed feature set" >&2
  exit 1
fi

expected_queue_import="crates/audio/src/capture.rs"
actual_queue_imports="$(
  find crates apps \
    -type f \
    -name '*.rs' \
    -exec grep -l 'crossbeam_queue::' {} + |
    LC_ALL=C sort
)"
if [[ "${actual_queue_imports}" != "${expected_queue_import}" ]]; then
  echo "crossbeam-queue imports escaped the private receive capture adapter" >&2
  echo "expected:" >&2
  echo "${expected_queue_import}" >&2
  echo "actual:" >&2
  echo "${actual_queue_imports:-<none>}" >&2
  exit 1
fi

callback_body="$(
  sed -n \
    '/BEGIN REALTIME CALLBACK/,/END REALTIME CALLBACK/p' \
    crates/audio/src/capture.rs
)"
for forbidden in \
  'Vec::' \
  '.to_vec(' \
  'Mutex' \
  'RwLock' \
  'sleep(' \
  'File::' \
  'Tcp' \
  'sqlite' \
  'protocol' \
  'decode' \
  'rig' \
  'client' \
  'build_output_stream'; do
  if grep -Fq "${forbidden}" <<<"${callback_body}"; then
    echo "real-time callback contains forbidden operation marker: ${forbidden}" >&2
    exit 1
  fi
done

if grep -En \
  'cpal::|crossbeam_queue::|mfsk_core::|rusqlite::|slotpilot_protocol|std::thread|sleep\(|build_(input|output)_stream|default_(input|output)_device' \
  crates/audio/src/timeline.rs; then
  echo "pure receive timeline gained device, protocol, persistence, or sleeping behavior" >&2
  exit 1
fi

if ! grep -Fq \
  'samples: Vec::with_capacity(FT8_RECEIVE_WINDOW_SAMPLES)' \
  crates/audio/src/timeline.rs; then
  echo "receive timeline must retain an explicitly bounded canonical window" >&2
  exit 1
fi

if grep -En \
  'std::thread|sleep\(|TransmitSupervisor|RigPort|build_output_stream|rusqlite::|serde::' \
  crates/operations/src/receive_clock.rs; then
  echo "receive clock monitor gained sleeping, authority, rig, output, persistence, or wire behavior" >&2
  exit 1
fi

if grep -REn \
  'cpal::|crossbeam_queue::|mfsk_core::|rustfft::|slotpilot_operations|slotpilot_api|std::thread|sleep\(|build_(input|output)_stream' \
  crates/storage/src; then
  echo "receive storage gained a private dependency, operations/API, device, output, or sleeping path" >&2
  exit 1
fi

if grep -Ein \
  'raw[_ ]?(pcm|audio)|waterfall|transmit_authority|resumable_ptt|arm_token' \
  crates/storage/migrations/0002_phase2_receive.sql; then
  echo "receive migration gained raw audio, waterfall, or live transmit-authority state" >&2
  exit 1
fi

if grep -En \
  'cpal::|crossbeam_queue::|mfsk_core::|slotpilot_protocol|rusqlite::|std::thread|sleep\(|build_(input|output)_stream|default_(input|output)_device' \
  crates/audio/src/spectrum.rs; then
  echo "receive spectrum gained callback, device, protocol, persistence, sleeping, or rendering behavior" >&2
  exit 1
fi

if grep -En \
  'cpal::|crossbeam_queue::|mfsk_core::|rustfft::|rusqlite::|std::thread|sleep\(|build_output_stream|default_(input|output)_device|TransmitSupervisor|RigPort|ptt|transmit_authority' \
  apps/daemon/src/receive.rs; then
  echo "daemon receive coordinator gained a private dependency, thread/sleep, fallback device, output, rig, PTT, or authority path" >&2
  exit 1
fi

for required in \
  'MAX_SPECTRUM_CHUNK_SAMPLES' \
  'MAX_SPECTRUM_ROWS_PER_PUSH' \
  'MAX_MODEL_BYTES' \
  'process_with_scratch' \
  'publication_pending'; do
  if ! grep -Fq "${required}" crates/audio/src/spectrum.rs; then
    echo "receive spectrum lost a required work, memory, scratch, or coalescing bound: ${required}" >&2
    exit 1
  fi
done

expected_dependency_import="crates/protocol/src/offline_adapter.rs"
actual_dependency_imports="$(
  find crates apps \
    -type f \
    -name '*.rs' \
    -exec grep -l 'mfsk_core::' {} + |
    LC_ALL=C sort
)"
if [[ "${actual_dependency_imports}" != "${expected_dependency_import}" ]]; then
  echo "mfsk-core imports escaped the private protocol adapter" >&2
  echo "expected:" >&2
  echo "${expected_dependency_import}" >&2
  echo "actual:" >&2
  echo "${actual_dependency_imports:-<none>}" >&2
  exit 1
fi

cargo doc --locked --no-deps --package slotpilot-protocol
if find target/doc/slotpilot_protocol \
  -type f \
  -name '*.html' \
  ! -path '*/src/*' \
  -exec grep -Eiq 'mfsk[_-]core' {} +; then
  echo "dependency-specific terminology leaked into public protocol rustdoc" >&2
  exit 1
fi

cargo doc --locked --no-deps --package slotpilot-audio
if find target/doc/slotpilot_audio \
  -type f \
  -name '*.html' \
  ! -path '*/src/*' \
  -exec grep -Eiq 'cpal|mfsk[_-]core|rustfft' {} +; then
  echo "device, protocol, or FFT dependency terminology leaked into public audio rustdoc" >&2
  exit 1
fi

if find \
  crates/protocol/src \
  crates/protocol/tests \
  -type f \
  -name '*.rs' \
  -exec grep -En \
    'std::process|std::net|Command::new|cpal|hamlib|rigctld|serialport' \
    {} +; then
  echo "offline protocol code gained an external process, network, device, or rig path" >&2
  exit 1
fi

if find \
  crates/audio/src \
  -type f \
  -name '*.rs' \
  -exec grep -En \
    'std::process|std::net|std::fs|Command::new|mfsk_core|hamlib|rigctld|serialport' \
    {} +; then
  echo "owned receive-audio contracts gained a process, I/O, device, protocol, or rig path" >&2
  exit 1
fi
