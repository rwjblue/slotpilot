#!/usr/bin/env bash
#MISE description="Verify the cross-platform CI contract"

set -euo pipefail

workflow=".github/workflows/ci.yml"
if [[ ! -f "${workflow}" ]]; then
  echo "missing CI workflow: ${workflow}" >&2
  exit 1
fi

for runner in "macos-latest" "ubuntu-latest" "windows-latest"; do
  if ! grep -Fq "${runner}" "${workflow}"; then
    echo "CI workflow must include ${runner}" >&2
    exit 1
  fi
done

if ! grep -Fq "run: mise run ci" "${workflow}"; then
  echo "CI workflow must invoke 'mise run ci'" >&2
  exit 1
fi

while IFS= read -r line; do
  if [[ ! "${line}" =~ @[0-9a-f]{40}([[:space:]]|$) ]]; then
    echo "GitHub Action is not pinned to a full commit SHA: ${line}" >&2
    exit 1
  fi
done < <(grep -E '^[[:space:]]*- uses:' "${workflow}")
