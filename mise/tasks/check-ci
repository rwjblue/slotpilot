#!/usr/bin/env bash
#MISE description="Verify the cross-platform CI contract"

set -euo pipefail

workflow=".github/workflows/ci.yml"
if [[ ! -f "${workflow}" ]]; then
  echo "missing CI workflow: ${workflow}" >&2
  exit 1
fi

for runner in "macos-latest" "ubuntu-latest" "windows-latest"; do
  if ! grep -Fq "${runner}" "${workflow}"; then
    echo "CI workflow must include ${runner}" >&2
    exit 1
  fi
done

if ! grep -Fq "run: mise run ci" "${workflow}"; then
  echo "CI workflow must invoke 'mise run ci'" >&2
  exit 1
fi

if ! grep -Fq "if: runner.os == 'Linux'" "${workflow}" ||
   ! grep -Fq "libasound2-dev" "${workflow}"; then
  echo "CI workflow must install CPAL's ALSA development headers on Linux" >&2
  exit 1
fi

mise_line="$(grep -nF "uses: jdx/mise-action@" "${workflow}" | cut -d: -f1)"
cargo_cache_line="$(grep -nF "uses: Swatinem/rust-cache@" "${workflow}" | cut -d: -f1)"
gate_line="$(grep -nF "run: mise run ci" "${workflow}" | cut -d: -f1)"

if [[ -z "${mise_line}" || -z "${cargo_cache_line}" || -z "${gate_line}" ]]; then
  echo "CI workflow must install tools, restore the Cargo cache, and run the gate" >&2
  exit 1
fi

if ((mise_line >= cargo_cache_line || cargo_cache_line >= gate_line)); then
  echo "Cargo cache must be restored after tool installation and before the gate" >&2
  exit 1
fi

for setting in \
  "continue-on-error: true" \
  "add-rust-environment-hash-key: false" \
  "cache-bin: false" \
  "cache-on-failure: false" \
  "key: slotpilot-" \
  "hashFiles(" \
  "save-if:" \
  "refs/heads/main"; do
  if ! grep -Fq "${setting}" "${workflow}"; then
    echo "CI workflow Cargo cache is missing required setting: ${setting}" >&2
    exit 1
  fi
done

while IFS= read -r line; do
  if [[ ! "${line}" =~ @[0-9a-f]{40}([[:space:]]|$) ]]; then
    echo "GitHub Action is not pinned to a full commit SHA: ${line}" >&2
    exit 1
  fi
done < <(grep -E '^[[:space:]]*- uses:' "${workflow}")
